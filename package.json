{
  "name": "hackinbrasil-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:all": "npm run lint && npm run lint:css",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^15.14.0",
    "jsdom": "^24.1.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^18.0.0",
    "vitest": "^4.1.11"
  }
}
