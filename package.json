    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^24.1.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^14.0.1",
    "vitest": "^2.1.8"
  }
}
